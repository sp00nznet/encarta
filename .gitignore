# Original media - do not commit
*.iso
*.7z

# Analysis working files
analysis/

# Claude settings
.claude/

# Build output
build/
out/
cmake-build-*/

# IDE files
.vs/
*.vcxproj.user
*.suo

# Tool output directories
m20_output/
spam_output/

# fif_test/ keeps only its committed test vectors; decoder output and full
# PICON extracts made from it stay local
fif_test/*.bmp
fif_test/*.png
fif_test/oracle_out/*.png
fif_test/picon_extract/

# The annotations file the app creates beside itself
encart97.ann

# netlab brings builds back here
build-farm/

# Everything lift.py / find_*.py generate is derived from the user's own
# ENC97.EXE, ENCAPI32.DLL or DECO_32.DLL, so none of it is distributed.
tools/recomp/enc97_*.c
tools/recomp/enc97_*.h
tools/recomp/encapi_lifted*
tools/recomp/lifted_*.c
tools/recomp/lifted_*.h

# Generated DECO_32 data blob (regenerated by gen_deco_data.py from the user's
# own DECO_32.DLL; a build artifact, not redistributed)
tools/recomp/deco32_data.c

# Python bytecode
__pycache__/
*.pyc
tools/indeo/runtime/build/

# Function lists of DECO_32.DLL (a disassembler's or a trace's output)
tools/decooracle/deco_funcs.txt
tools/decooracle/hot_functions.txt
