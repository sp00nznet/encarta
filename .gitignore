# Original media - do not commit
*.iso
*.7z

# Analysis working files
analysis/

# Claude settings
.claude/

# Build output
build/
out/
cmake-build-*/

# IDE files
.vs/
*.vcxproj.user
*.suo

# Tool output directories
m20_output/
spam_output/

# Generated decode output (keep source .ftc/.fif, exclude generated images)
fif_test/*.bmp
fif_test/*.png
fif_test/picon_extract/

# Oracle golden references: keep traces + crc snapshot, exclude regenerable images
fif_test/oracle_out/*.png
fif_test/oracle_out/*.bmp

# Generated ENC97 lift artifacts (regenerated by lift.py / find_*.py; 40 MB and
# derived from the user's own ENC97.EXE — not redistributed)
tools/recomp/enc97_full.c
tools/recomp/enc97_full_list.h
tools/recomp/enc97_pure_leaves.h
tools/recomp/enc97_deep_roots.h
tools/recomp/__pycache__/

# Generated DECO_32 data blob (regenerated by gen_deco_data.py from the user's
# own DECO_32.DLL; a build artifact, not redistributed)
tools/recomp/deco32_data.c

# Python bytecode
__pycache__/
*.pyc
